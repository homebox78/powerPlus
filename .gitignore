node_modules/
dist/
.env
*.log
.DS_Store

# 비밀키 / 배포 정보 — 절대 커밋 금지
*.pem
*.key
deploy.env
ftp.env
# 루트 config/ 는 시크릿 포함·미사용(코드는 server/config/ 를 읽음) — git 제외
/config/

# 원본 자산 대용량 폴더 — git 아닌 서버(uploads)에 보관
/data/

# 설치 exe는 git에 포함(다른 PC에서 pull하면 바로 받도록) — 배포/사용자/powerPlus_Setup.exe 추적

# data 아카이브(FTP로 직접 이동, git 제외)
data.7z
data*.7z
data*.zip

# 해커톤 신청 자료(개인 문서 — git 제외)
/해커톤_신청/

# Windows 썸네일 캐시(추적 금지)
Thumbs.db
thumbs.db

# 화면 캡처 원본(개인정보 미마스킹 — 마스킹본은 docs/manual/에 커밋)
/_capture/

# 소개 사이트 빌드 중간물 — publish.py 가 상위 폴더에 쓴 것만 추적한다
/website/_src/*.html
/website/_src/__pycache__/
/website/_src/*.bak
# 글꼴 원본을 만들 때 받는 임시 파일(전체 OTF 12MB×3)
/website/_src/fonts/_full/
