# powerPlus API (Apache) — 모든 요청을 index.php 로 라우팅

# 디렉터리 리스팅 차단
Options -Indexes

# 장표(.ppt/.pptx) 업로드를 위한 한도 상향 (mod_php 환경)
<IfModule mod_php7.c>
  php_value upload_max_filesize 40M
  php_value post_max_size 42M
</IfModule>
<IfModule mod_php.c>
  php_value upload_max_filesize 40M
  php_value post_max_size 42M
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Authorization 헤더를 PHP로 전달 (Apache/FastCGI 가 기본적으로 떼는 경우 대비)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 민감 디렉터리 직접 접근 차단 (HTTP 요청만 — PHP include 에는 영향 없음)
  RewriteRule ^(config|src|bin|sql|logs|lib)(/|$) - [F,L]

  # 실제 존재하는 파일/디렉터리는 그대로 제공
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 그 외 전부 프론트 컨트롤러로
  RewriteRule ^ index.php [L]
</IfModule>

# 민감 파일 직접 접근 차단 (mod_rewrite 없어도 보호, Apache 2.4)
<FilesMatch "\.(sql|md|json|pem|key|env|bak|ini|sh|lock|log|example\.php)$">
  Require all denied
</FilesMatch>

# 닷파일(.env, .git, .htaccess 등) 차단
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# 보안 헤더 (X-Frame-Options 는 Office 웹 애드인 iframe 동작 위해 의도적으로 미설정)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # 애드인 본체(app/)는 항상 재검증 — 배포 후 캐시로 옛 화면이 남는 문제 방지
  <FilesMatch "^(taskpane|commands)\.(html|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
